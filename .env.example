# Environnement : development | staging | production
WP_ENV=development

# Base de données (ignoré sous DDEV, qui fournit les siennes)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PREFIX=wp_

# URL du site, sans slash final (ignoré sous DDEV)
WP_HOME=

# Clés et salts : https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=''
SECURE_AUTH_KEY=''
LOGGED_IN_KEY=''
NONCE_KEY=''
AUTH_SALT=''
SECURE_AUTH_SALT=''
LOGGED_IN_SALT=''
NONCE_SALT=''

{
    "name": "loic9941/wp-starter",
    "description": "Boilerplate WordPress (wp-core + thème à blocs).",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Loic9941/wp-core"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.2",
        "loic9941/wp-core": "^0.1",
        "roots/wordpress": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "extra": {
        "wordpress-install-dir": "web/wp",
        "installer-paths": {
            "web/wp-content/plugins/wp-core/": ["loic9941/wp-core"],
            "web/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "web/wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
            "web/wp-content/themes/{$name}/": ["type:wordpress-theme"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "name": "loic9941/wp-starter",
    "description": "Boilerplate WordPress (wp-core + thème compatible Bricks).",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Loic9941/wp-core"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.2",
        "loic9941/wp-core": "^0.1"
    },
    "extra": {
        "installer-paths": {
            "wp-content/plugins/wp-core/": ["loic9941/wp-core"],
            "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
            "wp-content/themes/{$name}/": ["type:wordpress-theme"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "background", "name": "Fond", "color": "#ffffff" },
				{ "slug": "text", "name": "Texte", "color": "#1c1c1e" },
				{ "slug": "primary", "name": "Primaire", "color": "#1f3a5f" },
				{ "slug": "secondary", "name": "Secondaire", "color": "#4a5b6c" },
				{ "slug": "accent", "name": "Accent", "color": "#a34a20" },
				{ "slug": "light-gray", "name": "Gris clair", "color": "#f2f2f0" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Système",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Petite", "size": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" } },
				{ "slug": "base", "name": "Normale", "size": "1rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "medium", "name": "Moyenne", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "large", "name": "Grande", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "x-large", "name": "Très grande", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 1rem + 1vw, 1.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 1.25rem + 2vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 1.75rem + 3vw, 4rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 2.5rem + 4vw, 6rem)" }
			]
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				},
				":focus": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": { "radius": "4px" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": { "fontWeight": "600", "textDecoration": "none" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--secondary)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--secondary)" }
				}
			}
		}
	}
}
